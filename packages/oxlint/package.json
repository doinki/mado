{
  "name": "@mado/oxlint",
  "version": "0.2.0",
  "description": "Shared Oxlint configuration",
  "keywords": [
    "config",
    "lint",
    "oxc",
    "oxlint"
  ],
  "homepage": "https://github.com/doinki/mado/tree/main/packages/oxlint#readme",
  "bugs": "https://github.com/doinki/mado/issues",
  "license": "MIT",
  "author": {
    "name": "doinki",
    "email": "doinki94@gmail.com",
    "url": "https://github.com/doinki"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doinki/mado.git",
    "directory": "packages/oxlint"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "crawl": "node scripts/crawl.js",
    "generate": "node scripts/generate.js",
    "publint": "publint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-trim": "^1.0.3"
  },
  "devDependencies": {
    "oxlint": "^1.89.0"
  },
  "peerDependencies": {
    "oxlint": "^1.88.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
