{
  "name": "@mado/hooks",
  "version": "0.6.1",
  "description": "React hooks",
  "keywords": [
    "hooks",
    "react"
  ],
  "homepage": "https://github.com/doinki/mado/tree/main/packages/mado-hooks#readme",
  "bugs": "https://github.com/doinki/mado/issues",
  "license": "MIT",
  "author": {
    "name": "doinki",
    "email": "doinki94@gmail.com",
    "url": "https://github.com/doinki"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doinki/mado.git",
    "directory": "packages/mado-hooks"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c --environment NODE_ENV:production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@mado/utils": "workspace:^",
    "react-compiler-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-istanbul": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
