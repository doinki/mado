{
  "name": "@mado/utils",
  "version": "0.4.1",
  "homepage": "https://github.com/doinki/mado/tree/main/packages/mado-utils#readme",
  "bugs": "https://github.com/doinki/mado/issues",
  "license": "MIT",
  "author": {
    "name": "doinki",
    "email": "doinki94@gmail.com",
    "url": "https://github.com/doinki"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doinki/mado.git",
    "directory": "packages/mado-utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c --environment NODE_ENV:production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.0.5",
    "happy-dom": "^21.0.3"
  }
}
